#!/opt/homebrew/bin/bash

# Reset the output directory
rm -rf html
mkdir -p html

MANIFEST="manifest.json"
echo "[" > "$MANIFEST"

FILES=(markdown/*.md)
COUNT=${#FILES[@]}
INDEX=0

for md_file in "${FILES[@]}"; do
    [ -e "$md_file" ] || continue
    filename=$(basename "$md_file" .md)
    echo "Converting $filename..."
    pandoc "$md_file" -o "html/$filename.html"

    # Probe for images named <slug>1.webp, <slug>2.webp, ... contiguous,
    # starting at 1. Stops at the first missing number, so the last
    # successful index is both the count and the "last photo" index.
    IMAGE_COUNT=0
    n=1
    while curl --output /dev/null --silent --head --fail "https://img.vjbe.net/${filename}${n}.webp"; do
        IMAGE_COUNT=$n
        n=$((n + 1))
    done

    if [ "$IMAGE_COUNT" -gt 0 ]; then
        HAS_IMAGE="true"
        echo "  -> $IMAGE_COUNT image(s)"
    else
        HAS_IMAGE="false"
    fi

    INDEX=$((INDEX + 1))
    COMMA=","
    [ $INDEX -eq $COUNT ] && COMMA=""
    echo "  {\"slug\": \"$filename\", \"has_image\": $HAS_IMAGE, \"image_count\": $IMAGE_COUNT}$COMMA" >> "$MANIFEST"
done

echo "]" >> "$MANIFEST"
echo "Done! Manifest generated and HTML converted."
